{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/validate_brain_file.py",
            "if": "Edit(brain/**)",
            "statusMessage": "Validating brain file provenance",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
