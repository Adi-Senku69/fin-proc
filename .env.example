# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Get a key: https://console.anthropic.com/settings/keys
#
# NONE OF THIS IS REQUIRED to clone and run the project: NVPLAN_AI_PROVIDER defaults to "auto",
# which is deterministic (no key, no network) unless a credential is present, and the one path
# that can write into brain/ pins itself to deterministic regardless (see
# NVPLAN_AI_BRAIN_WRITE_PROVIDER below). Only fill in ANTHROPIC_API_KEY when you deliberately want
# real model calls.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional overrides (defaults live in nvplan/config.py)
# NVPLAN_AI_MODEL=claude-opus-5
# NVPLAN_AI_EFFORT=high
# NVPLAN_AI_MAX_TOKENS=16000
# NVPLAN_AI_BETAS=                      # comma-separated Anthropic beta flags (escape hatch)

# Provider selection (A1/B2, nvplan/config.py). Closed set: auto | live | deterministic.
# "auto" (the default for both) uses the real model when ANTHROPIC_API_KEY (or an "ant" CLI
# profile) is resolvable, deterministic offline otherwise - so dropping a key in THIS file makes
# every "auto" touchpoint go live. NVPLAN_AI_BRAIN_WRITE_PROVIDER exists precisely because that is
# wrong for the one path that writes into brain/: it defaults to "deterministic" independent of
# the key above, so an env scan never drafts a brain/ file from a live model unless you opt in here too.
# NVPLAN_AI_PROVIDER=auto
# NVPLAN_AI_BRAIN_WRITE_PROVIDER=deterministic

# Only needed for an organization-level key: forwarded as the anthropic-workspace-id header.
# A workspace-scoped key routes itself and needs nothing here.
# ANTHROPIC_WORKSPACE_ID=
