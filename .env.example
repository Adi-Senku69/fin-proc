# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional overrides (defaults live in nvplan/config.py)
# NVPLAN_AI_MODEL=claude-opus-5
# NVPLAN_AI_EFFORT=high
# NVPLAN_AI_MAX_TOKENS=16000
# NVPLAN_AI_BETAS=                      # comma-separated Anthropic beta flags (escape hatch)

# Only needed for an organization-level key: forwarded as the anthropic-workspace-id header.
# A workspace-scoped key routes itself and needs nothing here.
# ANTHROPIC_WORKSPACE_ID=
